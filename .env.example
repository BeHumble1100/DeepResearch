# Copy this file to .env and adjust it for your local SearXNG instance.
SEARXNG_BASE_URL=http://localhost:8080
SEARXNG_TIMEOUT_SECONDS=10
SEARXNG_MAX_RETRIES=2
SEARXNG_RETRY_BACKOFF_SECONDS=0.25
SEARXNG_MAX_RESULTS=10
DOCUMENT_TIMEOUT_SECONDS=20
DOCUMENT_STORE_DIR=.deepresearch/documents
RETRIEVAL_CHUNK_SIZE_CHARS=1200
RETRIEVAL_CHUNK_OVERLAP_CHARS=200
RETRIEVAL_BM25_TOP_K=8
RETRIEVAL_TOP_N=3
